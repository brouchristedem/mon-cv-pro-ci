rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque utilisateur ne peut lire/écrire que son propre document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Parrainage : quand un filleul confirme son premier paiement, son
      // compte doit créditer celui de son parrain. On autorise cette seule
      // opération, depuis un compte différent, de façon très restreinte :
      // uniquement les deux champs de parrainage, uniquement en hausse d'une
      // récompense à la fois. Aucune lecture n'est permise : le filleul ne
      // voit jamais le contenu du compte du parrain.
      allow update: if request.auth != null && request.auth.uid != userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["referralCreditFCFA", "referralCount"]) &&
        request.resource.data.referralCount == resource.data.referralCount + 1 &&
        request.resource.data.referralCreditFCFA == resource.data.referralCreditFCFA + 250;
    }

    // Table de correspondance code de parrainage -> propriétaire. Lecture
    // publique (nécessaire pour créditer le bon parrain), mais chacun ne
    // peut créer que le mapping de son propre compte, et il est immuable
    // une fois créé.
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Codes promo : lecture publique (pour vérifier un code), écriture réservée à l'admin
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Réglages généraux (prix, etc.) : lecture publique, écriture admin uniquement
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Statut actif/inactif des templates : lecture publique, écriture admin uniquement
    match /templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Journal des déclarations de paiement (lecture nécessaire pour vérifier qu'une
    // référence Wave n'est pas réutilisée deux fois)
    match /paymentClaims/{claimId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow delete: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }
  }
}
